.DS_Store
**/.ipynb_checkpoints/
**/__pycache__/
.pytest_cache/
node_modules/
_build/
.myst/

# Provider and generated data remain local unless explicitly reviewed for release.
data/raw/**
data/recovery/**
data/processed/**

# Files a script fetched for itself, kept separate from what a human downloaded.
data/code-downloaded/**

# Generated figures may be recreated; add a reviewed figure explicitly if the site needs it.
figures/**

# Reviewed figures embedded in notebooks — these must ship with the repo.
!figures/fig1.png
!figures/fig2.png
!figures/fig3.png
!figures/fig4.png

# Throwaway files students generate during the AI session; not course material.
scratch_*

# Python packaging build artifacts
*.egg-info/

# Derived lookup tables the El Nino notebooks need on fresh clones; regenerating
# needs reefbreak + MATLAB (slopes) or ~700 CDIP metadata requests (coords).
!data/code-downloaded/vost_seasonal_slopes.csv
!data/code-downloaded/mop_ca_numbers.csv
!data/code-downloaded/mop_transect_coords.csv

# UHSLC tide gauge files ship with the repo so the El Nino notebooks work
# offline in class (freely redistributable; ~9 MB total).
!data/raw/uhslc/
!data/raw/uhslc/*.nc
